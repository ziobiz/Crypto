# WebAuthn (HTTPS required in production)
WEBAUTHN_RP_ID=example.com
WEBAUTHN_ORIGINS=https://example.com,https://www.example.com
WEBAUTHN_RP_NAME=MyApp

# Absolute origin for QR approve deep links
PUBLIC_WEB_URL=https://example.com

# Optional TTL overrides (ms)
# WEBAUTHN_CHALLENGE_TTL_MS=300000
# LOGIN_QR_TTL_MS=120000
