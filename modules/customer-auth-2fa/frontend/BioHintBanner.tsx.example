      .catch(() => undefined);
    return () => {
      cancelled = true;
    };
  }, [user, fetchCredentials]);

  if (!visible || !user) return null;

  const dismiss = () => {
    localStorage.setItem(storageKey(user.id), new Date().toISOString());
    setVisible(false);
  };

  return (
    <div role="status" className="bio-hint-banner">
      <div>
        <p>{t('auth.bioHintBannerTitle')}</p>
        <p>{t('auth.bioHintBannerBody')}</p>
      </div>
      <div>
        <Link href={accountHref} onClick={dismiss}>
          {t('auth.bioHintBannerCta')}
        </Link>
        <button type="button" onClick={dismiss}>
          {t('auth.bioHintBannerDismiss')}
        </button>
      </div>
    </div>
  );
}
